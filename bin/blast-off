#!/usr/bin/env bash
# blast-off: run one large multi-phase coding job as a chain of checkpointed Claude Code sessions,
# under a systemd user unit, with no Claude session open to drive it. A job dir holds brief.md and
# checkpoint.md; the workdir defaults to the job dir's parent. Each child reads the checkpoint,
# works, rewrites it and stops; the runner relaunches until status is done or blocked.
#
# Usage: blast-off run <job-dir> [workdir]   the chain loop in the foreground (the unit's ExecStart)
#        blast-off start <job-dir>            run it as transient unit blast-off-<name>.service
#        blast-off status|stop|logs <job-dir> checkpoint header + unit state · stop unit and children · logs
#        blast-off resume <job-dir>           paused-cap, or paused-limit after its reset: running, then start
#        blast-off install                    write the template and slice to ~/.config/systemd/user
#        blast-off receipt <job-dir> <phase> [workdir]  last GATE: line of gate-logs/phase-<phase>.log + HEAD -> phase-<phase>.json
#        blast-off ci-wait <job-dir> <pr> [workdir]  watch each CI run of the PR head; conclusions -> gate-logs/ci-pr-<pr>.json
#  env:  CLAUDE_FLAGS (required)   --model, --effort and any other flags for every child
#        JOB_CHILD_TIMEOUT=7200    seconds one child may run before it is killed and replaced
#        JOB_CAP_FACTOR=3          soft cap = Phase plan rows in checkpoint.md times this
#        JOB_MAX_CHILDREN          overrides the soft cap; with no Phase plan table, the hard cap (default 12)
#        JOB_SESSION=job-<name>    tmux session on the job's own server, tmux -L blast-off-<name>
#        JOB_KEEP_WINDOWS=1        leave finished children's windows open
#        BLAST_OFF_TRUST_SECONDS=60  seconds after a child starts that its trust dialog is answered
#        JOB_USAGE_PAUSE=95        pause when a usage window is at or above this percent at a child's end
#        JOB_RESUME_MARGIN=60      seconds after a usage reset that the resume timer fires
#        JOB_API_BACKOFF=600       seconds before the next child after an API error that clears (overloaded, server_error, unknown)
#        BLAST_OFF_STATE_DIR=~/.claude/state  where the status line records each session's usage
#        BLAST_OFF_CI_APPEAR=60    seconds ci-wait waits for a PR head's runs to be listed (not to finish)
# Exit:  0 done · 1 usage, dependency or runner error · 3 blocked (needs the owner) · 4 hard child cap reached
#        5 two children in a row left checkpoint.md unchanged · 6 soft cap reached, status paused-cap (run again)
#        7 uncommitted paths checkpoint.md does not name (after a child or before child 1)
#        8 usage limit: status paused-limit until <time>; <unit>.resume.timer runs `blast-off resume` then
#        9 a done Phase plan row names no commit, or lacks a PASS receipt for it · 10 done refused: a PR's CI red or unread
set -euo pipefail

BLAST_OFF_HOME="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for f in "$BLAST_OFF_HOME"/lib/*.sh; do
  # shellcheck source=/dev/null
  source "$f"
done

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG"; }
die() { echo "blast-off: $*" >&2; exit 1; }

# job_init <job-dir> [workdir]: JOB, WORKDIR, NAME (workdir basename), UNIT, SESSION, LOG.
job_init() {
  [ -n "${1:-}" ] || die "missing <job-dir>"
  JOB="$(cd "$1" && pwd)" || die "no job dir $1"
  WORKDIR="$(cd "${2:-$(dirname "$JOB")}" && pwd)" || die "no workdir ${2:-}"
  NAME="$(basename "$WORKDIR")"
  [[ $NAME =~ ^[A-Za-z0-9_-]+$ ]] || die "workdir name '$NAME' must be letters, digits, '-' or '_' (it names the unit and tmux session)"
  # shellcheck disable=SC2034  # UNIT, SESSION: read by lib/*.sh
  UNIT="blast-off-$NAME"
  # shellcheck disable=SC2034
  SESSION="${JOB_SESSION:-job-$NAME}"
  LOG="$JOB/run.log"
}

case "${1:-}" in
  run) shift; job_init "$@"; chain_run ;;
  start|status|stop|logs|resume) job_init "${2:-}"; "unit_$1" ;;
  receipt) job_init "${2:-}" "${4:-}"; receipt_write "${3:-}" ;;
  ci-wait) job_init "${2:-}" "${4:-}"; ci_wait "${3:-}" ;;
  install) units_install ;;
  -h|--help|"") sed -n '2,30p' "$0" ;;
  *) die "unknown command '$1' (see blast-off --help)" ;;
esac
