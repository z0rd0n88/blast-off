# blast-off@.service: one job's chain runner. The instance is the job dir, path-escaped:
#   systemctl --user start "blast-off@$(systemd-escape --path /abs/job-dir).service"
# %f undoes the escaping and prepends "/", so `run` gets the absolute job dir.
# The user manager's environment holds no CLAUDE_FLAGS or GH_TOKEN and a PATH without claude, so a
# hand-started instance exits 1; `blast-off start` runs the transient form, passing those names with
# --setenv and reading every [Service] directive below as a -p property.
# `blast-off install` writes this file with /home/alex/blast-off/.worktrees/blast-off-build/bin/blast-off replaced by the checkout's bin/blast-off.
# No Restart=: the runner's non-zero exits are states (blocked, paused, ...), not failures.
# No [Install]: never enabled (D6).
[Unit]
Description=blast-off job %f

[Service]
Type=exec
ExecStart=/home/alex/blast-off/.worktrees/blast-off-build/bin/blast-off run %f
Slice=blast-off.slice
KillMode=control-group
ManagedOOMPreference=avoid
TimeoutStopSec=60
