#!/usr/bin/env bash
# Fake jev for scenarios; never calls the real one or any network. State lives in $FAKE_JEV (a dir):
#   answer   the choice it returns for question `level` (default: other)
#   fail     present: exit 2 with an error on stderr, as jev does on an HTTP failure
#   calls    one line per call: argv, then the route facts it saw (TYPESAFE_API_KEY and JEV_BASE_URL set
#            or unset, the OPENROUTER_API_KEY prefix), appended
#   state-<n> the state the n-th call read on stdin
# Answers like `jev -q '<json>'`: the .answers object, {"level":{"choice":...,"confidence":...}}.
set -euo pipefail
: "${FAKE_JEV:?fake jev needs FAKE_JEV}"
n=$(( $(wc -l < "$FAKE_JEV/calls" 2>/dev/null || echo 0) + 1 ))
printf 'argv=%s typesafe=%s base=%s key=%s\n' "$*" "${TYPESAFE_API_KEY:+set}" "${JEV_BASE_URL:+set}" "${OPENROUTER_API_KEY:0:6}" >> "$FAKE_JEV/calls"
cat > "$FAKE_JEV/state-$n"
[ ! -e "$FAKE_JEV/fail" ] || { echo '{"error":"fake failure"}' >&2; exit 2; }
jq -n --arg c "$(cat "$FAKE_JEV/answer" 2>/dev/null || echo other)" '{level: {choice: $c, confidence: 0.87, probabilities: {}}}'
