#!/usr/bin/env bash
# Fake gh for scenarios; never calls the real one. State lives in $FAKE_GH (a dir):
#   pr-<n>-head      the PR's head sha            runs-<sha>   run ids for that commit, one per line
#   run-<id>         that run's conclusion, read only after `run watch <id>` (before it, in progress: "")
#   later-<sha>      run ids listed from the second `run list` of that commit on (runs not yet listed at a
#                    push, or a workflow queued after the first finishes)
#   calls            every call, one per line, each followed by `cwd=<dir>` (appended)
set -euo pipefail
: "${FAKE_GH:?fake gh needs FAKE_GH}"
echo "$*" >> "$FAKE_GH/calls"; echo "cwd=$PWD" >> "$FAKE_GH/calls"
case "$1 $2" in
  "pr view") cat "$FAKE_GH/pr-$3-head" > /dev/null && jq -n --arg h "$(cat "$FAKE_GH/pr-$3-head")" '{headRefOid: $h}' ;;
  "run list") [ "$3" = --commit ] || { echo "fake gh: run list needs --commit" >&2; exit 1; }
    n="$(grep -c "^run list --commit $4 " "$FAKE_GH/calls")"
    { cat "$FAKE_GH/runs-$4" 2>/dev/null || true
      [ "$n" -lt 2 ] || cat "$FAKE_GH/later-$4" 2>/dev/null || true
    } | jq -R 'tonumber | {databaseId: .}' | jq -s . ;;
  "run watch") [ "$(cat "$FAKE_GH/run-$3")" = success ] ;;
  "run view") c="$(cat "$FAKE_GH/run-$3")"; grep -qx "run watch $3 --exit-status" "$FAKE_GH/calls" || c=
    jq -n --argjson id "$3" --arg c "$c" '{databaseId: $id, name: "ci-\($id)", conclusion: $c}' ;;
  *) echo "fake gh: unknown call: $*" >&2; exit 1 ;;
esac
